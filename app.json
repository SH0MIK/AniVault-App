{
  "expo": {
    "name": "AniVault",
    "slug": "anivault",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "anivault",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08090c",
    "icon": "./assets/icon.png",
    "splash": { "image": "./assets/splash.png", "backgroundColor": "#08090c", "resizeMode": "contain" },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "co.anivault.app" },
    "android": {
      "package": "co.anivault.app",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#08090c" }
    },
    "plugins": [
      ["expo-notifications", { "icon": "./assets/adaptive-icon.png", "color": "#E8453C" }],
      "./plugins/withDiscordPresence"
    ]
  }
}
